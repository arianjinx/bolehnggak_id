#!/bin/sh
agents='claude|anthropic|cursor|copilot|codex|openai|chatgpt|gemini|devin|ampcode|opencode|aider|codeium|windsurf|\[bot\]'
if grep -Eiq "^co-authored-by:.*($agents)" "$1"; then
  printf 'commit-msg: remove the Co-authored-by trailer that names an agent. AGENTS.md says never to put an agent in a commit.\n' >&2
  exit 1
fi
for who in "$(git var GIT_AUTHOR_IDENT)" "$(git var GIT_COMMITTER_IDENT)"; do
  if printf '%s\n' "$who" | sed 's/ [0-9]* [+-][0-9]*$//' | grep -Eiq "$agents"; then
    printf 'commit-msg: an agent is the author or committer (%s). Commit as the owner. AGENTS.md says never to put an agent in a commit.\n' "$who" >&2
    exit 1
  fi
done
